# IVIS LABS Chat API Configuration Example
# Copy this file to .env and add your actual credentials

REACT_APP_API_BASE_URL=https://chat.ivislabs.in
REACT_APP_API_KEY=your-api-key-here

# Property Backend API URL
# In development: http://localhost:5000 (default, no need to set)
# In production: set to your backend domain
REACT_APP_API_URL=https://realbackend.ivislabs.in

# Optional: File ID for RAG (Retrieval Augmented Generation)
# If you have uploaded knowledge base files to IVIS LABS platform
# REACT_APP_FILE_ID=your-file-id-here
